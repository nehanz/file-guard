# Application Settings
ENVIRONMENT=development
PROJECT_NAME=File Guard API
VERSION=0.1.0
API_V1_STR=/api/v1

# API Endpoint Configuration (customize routes if needed)
AUTH_ENDPOINT=/auth
USERS_ENDPOINT=/users
FILES_ENDPOINT=/files
HEALTH_ENDPOINT=/health

# Security
SECRET_KEY=change_this_to_a_long_random_string_for_jwt_signing
CORS_ORIGINS=*

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes
ALLOWED_EXTENSIONS=[".pdf", ".png", ".jpg", ".jpeg", ".docx", ".txt", ".csv"]
UPLOAD_DIR=uploads

# Database
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=file_guard

# Logging
LOG_LEVEL=DEBUG

# Blockchain Settings (Required for blockchain integration)
# Get WEB3_PROVIDER_URI from your blockchain node (Anvil, Infura, Alchemy, etc.)
WEB3_PROVIDER_URI=http://127.0.0.1:8545

# Get ETH_PRIVATE_KEY from:
# - Anvil: Check terminal output when you run 'anvil' (use any of the 10 test accounts)
# - Production: Generate with 'cast wallet new' and fund the account
# WARNING: Never commit real private keys to version control
ETH_PRIVATE_KEY=

# Get CONTRACT_ADDRESS after deploying FileIntegrity.sol
# Run: export DEPLOY_PRIVATE_KEY=<your_key> && ./scripts/deploy_contract.sh
CONTRACT_ADDRESS=
